{
  "name": "chat-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:prod": "npm run migrate up && node src/server.js",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -j sql",
    "invite": "node --env-file-if-exists=.env scripts/create-invite.js",
    "test-email": "node --env-file-if-exists=.env scripts/test-email.js",
    "vapid": "node scripts/generate-vapid.js",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  }
}
