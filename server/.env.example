# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed so others know which keys exist.

PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed by CORS (browser clients only).
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/chat_app

# Secret used to sign access tokens. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret

# Number of reverse proxies in front of the server (0 locally, 1 on Render).
TRUST_PROXY=0

# Public URL of the web app (used in password-reset emails).
APP_URL=http://localhost:5173

# Email via SMTP, for password-reset links. Leave SMTP_HOST empty in development:
# the reset link is then printed in this server's terminal instead of emailed.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a Google "App password", NOT your normal password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Private Chat <no-reply@example.com>
