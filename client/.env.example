# Copy to .env.local if you need to override. Only variables starting with VITE_
# are exposed to browser code, so NEVER put secrets here: the browser sees all of it.

# REST API base. Leave EMPTY both locally and on Vercel: requests go to /api on the app's own
# site (Vite proxy locally, the rewrite in vercel.json in production). Same-site keeps the
# login cookie working in every browser, including Safari.
VITE_API_URL=

# Live connection (Socket.IO) + encrypted media uploads/downloads go straight to the backend.
# Empty locally. On Vercel: your Render URL, e.g. https://your-api.onrender.com
VITE_REALTIME_URL=
